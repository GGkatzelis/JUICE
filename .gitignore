# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings (personal, not shared)
.claude/
!.claude/log_prompt.py

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Distribution / packaging
build/
dist/
*.egg-info/

# Temporary simulation outputs (the canonical references are saved as
# simulation_results_linear.csv and simulation_results_piecewise.csv)
**/simulation_results.csv
**/simulation_kinetics.npz
**/simulation_reactions.csv

# mcm_full result CSVs exceed GitHub's 50 MB recommended / 100 MB hard limit
# (5842 species × 18 h × 2020 timesteps = 75 MB linear / 275 MB piecewise).
# Regenerate via `python scenario_runner.py scenario_config.json`.
MCM_tested_scenarios/IDL Input/mcm_full/simulation_results_linear.csv
MCM_tested_scenarios/IDL Input/mcm_full/simulation_results_piecewise.csv

# Large chemistry rendering artefacts (can be regenerated from .fac/.cs)
**/chemspace_animation.mp4
**/chemspace_animation.gif

# Experimental ENZ/config variants (e.g. O3/HO2-constrained diagnostics)
**/kammer_with*.enz
**/scenario_config_*constrained*.json

# MCM database subsets not yet part of the shipped release
MCM_database/MCM_3.3.1/Limonene/

# FACSIMILE compilation byproducts (PostScript plots, HTML logs, .sav).
# The .cs timeseries is the authoritative reference and stays in the repo.
**/*.cs.ps
**/*.kv.ps
**/*.pd.ps
**/*.UTC.ps
**/*.sav
**/*.html
**/*.hd
**/*.elog
# Allow canonical elogs committed under MCM_tested_scenarios for benchmark reproducibility
!MCM_tested_scenarios/**/*.elog

# Machine-local TOML overrides (last_easy_dir, etc.) — never committed
*.local.toml

# JUICE simulation output directory when output_root is inside the repo (Georgios layout)
MCM_tested_scenarios/JUICE archive/

# Local logs / scratch
*.log
/tmp/

# Personal/lecture work — never committed, local-only scratch
lecture/

# Test-scenario folders: keep inputs (.easy/.enz/.fac/.elog/.json/include files) and
# the FACSIMILE .cs references; large derived outputs stay local (GitHub 100 MB limit)
MCM_tested_scenarios/IDL Input/**/*.kv
MCM_tested_scenarios/IDL Input/**/*.pd
MCM_tested_scenarios/IDL Input/**/*.ps
MCM_tested_scenarios/IDL Input/**/*.sav
MCM_tested_scenarios/IDL Input/**/*.hd
MCM_tested_scenarios/IDL Input/**/*.html
MCM_tested_scenarios/IDL Input/**/*.out
MCM_tested_scenarios/IDL Input/**/*.npz
MCM_tested_scenarios/IDL Input/**/*.png
MCM_tested_scenarios/IDL Input/**/*.svg
MCM_tested_scenarios/IDL Input/**/*.log
MCM_tested_scenarios/IDL Input/**/*_juice.*
MCM_tested_scenarios/IDL Input/**/*_reactions.csv
MCM_tested_scenarios/IDL Input/**/flowchart*
MCM_tested_scenarios/IDL Input/**/* - Kopie.*

# machine-specific shortcut (absolute paths); recreate with: python make_shortcut.py --here
JUICE.lnk

# per-day observation extracts next to results (regenerated from the archive; keep the reference scene folders clean in git)
MCM_tested_scenarios/IDL Input/**/*.observations.csv
