; cracmm1_aq.physics.incl -- CRACMM 1 (with aqueous chemistry) from the F0AM chemistry library (Chem/CRACMM1), converted by f0am_import.py 2026-11-10
; Place et al. (2023); F0AM version of the CMAQ mech.def by B. Place (EPA).  F0AM: Wolfe et al. (2016), github.com/AirChem/F0AM, GPL-3.0.
; source files sha256[:16]: CRACMM1_aq_AllRxns.m f0da69db5027b018, CRACMM1_aq_K.m 5dcfc89020cac14c, CRACMM1_aq_J.m efe7c9010e7f2ecb
; physics: air density from the pressure and temperature settings, F0AM's constant species
CONST=FUNCTION[%1]
DENSITY=FUNCTION[(%1)/((%2)*1.379E-19)]
M =DENSITY(P,T)
O2=CONST(0.2095*M)
N2=CONST(0.7808*M)
H2=CONST(5.6E-7*M)
CH4=CONST(1.85E-6*M)   ; held constant, as in F0AM and CMAQ
