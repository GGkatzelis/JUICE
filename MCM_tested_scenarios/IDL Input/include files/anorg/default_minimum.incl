ALIAS[CH3OOH] = CH3O2H MOOH
ALIAS[HONO] = HNO2
ALIAS[HNO3] = HONO2
ALIAS[HNO4] = HO2NO2
HV=CONST(1.)
SZA=CONST(45.)
