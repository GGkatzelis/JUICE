CONST=FUNCTION[%1]
DENSITY=FUNCTION[(%1)/((%2)*1.379E-19)]
T =CONST(273.2)
P =CONST(1013.)
M =DENSITY(P,T)
O2=CONST(0.20946*M)
N2=CONST(0.78084*M)
