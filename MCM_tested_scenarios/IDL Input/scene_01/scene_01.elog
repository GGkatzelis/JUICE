FILES[ENZ] = scene_01.enz
FACS[HMAX] = 10
FACS[OUTSTEP]= 10
INITIAL[X] = CONST(0)
INITIAL[Y] = CONST(0)
CONST =FUNCTION[%1]
DENSITY=FUNCTION[(%1)/((%2)*1.379E-19)]
Q=input(Q)
T=CONST(295)
P=CONST(1013)
M=DENSITY(P,T)
Q-->X
Q-->Y
Y+DIL-->
k[Q-->X] =CONST(M*1e-9/60*1)
k[Q-->Y] =CONST(M*1e-9/60*1)
k[Y+DIL-->]=CONST(DILUTE)
DIL = CONST(1)
DILUTE = CONST(150/275 / 3600)
MR_X=CONST(X/M*1e9)
MR_Y=CONST(Y/M*1e9)
