;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#include VOC_Quellen_CHANEL2024.incl
injection_volume_BIOGENIC=CONST(0)
injection_volume_DIESEL  =CONST(0)
injection_volume_GASOLINE=CONST(0)
injection_volume_COOKING =CONST(0)
injection_volume_VCP1    =CONST(0)
injection_volume_VCP2    =CONST(0)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;QL=CONST(0.5028) ; *0.7
QL=CONST(1e-3*0.841/136*22.4/275000*1e9)   ; Limonen-Dichte 0.841g/mL, MolGW Limonen 136g/mol, 275000 Volumen SAPHIR, Mol-Volumen ideales Gas 22.4L/mol

q_limonene=input(q_limonene)
q_limonene-->LIMONENE
k[q_limonene-->LIMONENE]=CONST(M*1e-9/(60*5)*QL)

