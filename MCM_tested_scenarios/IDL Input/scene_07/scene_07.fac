 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>*sc<*,#1>;
 ARRAY end;
 LABEL 48;
 DO 50 FOR #50=#nvar,#51=#nbox,#52=#nset,#53=#nbox,#54=10;
 ENTER tout c s ;
 LABEL 50;
 DO 49 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>/sc<*,#1>;
 ARRAY end;
