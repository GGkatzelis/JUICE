*********************************************************************
 
;/MEASURED, use measured photolysis frequencies (given in ENZ-file)
;           and other measured parameters]
;#include saphir.jmeasured_02.incl ! E:\Python Code\JUICE archive\EASY\include files\anorg\
;------------------------------------------------------------------
; gemessenes J
; Benötigte Funktionen
AMAX =FUNCTION[AMAX(%1,%2)]
AMIN =FUNCTION[AMIN(%1,%2)]

ARRH=FUNCTION[(%1)*exp((%2)/T)] 

; geändert F.Rohrer 16.07.2023
;PHOTMMSC=FUNCTION[(%1)*COS(AMIN(SZA,89.9)*3.141593/180)@(%2)*        ;                  exp(-1.*(%3)/COS(AMIN(SZA,89.9)*3.141593/180))*    ;                  AMIN(1+5*COS(AMIN(SZA,89.9)*3.141593/180),    ;                  (%7)/((%4)*COS(AMIN(SZA,89.9)*3.141593/180)@(%5)*   ;                  exp(-1.*(%6)/COS(AMIN(SZA,89.9)*3.141593/180))))]

PHOTMMSC= FUNCTION[((%1)* ((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))* (AMIN(((%7) / ((%4)*((AMAX(COSX,0.01))@(%5)) * exp((%6)/AMAX(COSX,0.01))) ),1.))]
PHTFKT  = FUNCTION[((%1)* ((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))* (AMIN((jno2 / (LNO2*((AMAX(COSX,0.01))@MNO2) * exp(NNO2/AMAX(COSX,0.01))) ),1.))]

hv + NO2 -/-> O + NO 
NO2 + hv --> O3 + NO

HV + O3 -/-> O

NO3 + hv -/-> NO2 + O
NO3 + hv--> NO2 + O3

HNO3 + hv --> OH + NO2 

; jno2 = INPUT(jno2)
; k[NO2 + hv --> O3 + NO] = CONST( jno2 )

; jo1d = INPUT(jo1d)
; k[O3+hv-->O1D] = CONST( jo1d )

; k[H2O2 + hv --> 2*HO ]   = INPUT(jh2o2)
; k[HONO + hv --> OH + NO] = INPUT( jhono )
; k[HCHO + hv --> H2 + CO ] = INPUT( jhcho_m )
; k[HCHO + hv --> 2*HO2 + CO ] = INPUT( jhcho_r )
; k[CH3CHO + hv --> CH3O2 + CO + HO2 ] = INPUT(jch3cho_r)

;anorganic
k[NO3+hv-->NO]      = PHOTMMSC(2.485e-2,0.168,0.108,1.165e-2,0.244,0.267,jno2)
k[NO3+hv-->NO2+O3]  = PHOTMMSC(1.747e-1,0.155,0.125,1.165e-2,0.244,0.267,jno2)
k[HNO3+hv-->OH+NO2] = PHOTMMSC(9.312e-7,1.230,0.307,1.165e-2,0.244,0.267,jno2)

;organic
;k[CH3CHO + hv --> CH3O2 + CO + HO2 ] = PHOTMMSC(8.443e-6,1.177,0.437,1.165e-2,0.244,0.267,jno2)
k[CH3CHO + hv --> CH3O2 + CO + HO2 ] = PHOTMMSC(7.344e-6,1.202,0.417,1.165e-2,0.244,0.267,jno2)
;k[NO3CH2CHO + hv --> HO2+CO+HCHO+NO2] = PHOTMMSC(3.363e-6,1.296,0.322,1.165e-2,0.244,0.267,jno2)
;k[NO3CH2CHO + hv --> NO2+HCOCH2O] = PHOTMMSC(7.549e-6,1.015,0.324,1.165e-2,0.244,0.267,jno2)
k[NO3CH2CHO + hv --> NO2+HCOCH2O] = PHOTMMSC(1.87695e-4, 4.6827, 1.3889,1.165e-2,0.244,0.267,jno2)

;???   --> Siehe Mail an Theo in NOx Ordner
