; k[NO3C2H4OOH + hv --> 0.5*NO2+0.5*H2O+0.5*NO3CH2CHO+HCHO+OH] = PHOTMMMSC(7.649e-6,0.682,0.279,1.165e-2,0.244,0.267,jno2)


