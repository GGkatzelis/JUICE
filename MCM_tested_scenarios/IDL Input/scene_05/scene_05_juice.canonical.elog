*********************************************************************
 
;/WALLDEP, Wall deposition in SAPHIR chamber
;#include saphir.walldep.incl ! E:\Python Code\JUICE archive\EASY\include files\
; saphir.walldep.incl
; Erstellt von Cornelia Richter
; Erneuert von F.Rohrer

; Lebensdauer gegen Wandverlust ungefähr = 3 Tage
; DV = 1/(3Tage * 24 Stunden/Tag * 3600 Sekunden/Stunde) = 1/(3*24*3600) s^-1
DV     = CONST(3.858e-06)
DVO3 = CONST(1.0/30.0/3600.0)
;
HNO3 --> NA
HONO --> NA
H2O2 -->
HO2  -->
O3   -->
N2O5 --> 2*NA

k[HNO3 --> NA] = CONST( WALLDEP * DV )
k[HONO --> NA] = CONST( WALLDEP * DV )
k[H2O2 --> ] = CONST( WALLDEP * DV )
k[HO2  --> ] = CONST( WALLDEP * DV )
k[O3   --> ] = CONST( WALLDEP * DV )
k[N2O5 --> 2*NA] = CONST( WALLDEP * DV )
;#include saphir.walldep.incl
WALLDEP   = CONST(1.) ; Switch fuer die Wandverluste 
 
*********************************************************************
 
;/SOURCE, HONO and HCHO source of SAPHIR chamber

; Funktion die die Wasserkonzentration in die relative
; Feuchtigkeit umrechnet
WVC2RH     =FUNCTION[%1*100./(exp(21.36469-5339.66/T)/P*M)]

; Relative Feuchtigkeit
RH = WVC2RH(H2O)

; HONO Quelle aus Paper Rohrer et al.
SHONO --> HONO
k[SHONO --> HONO]  = CONST( 4.7e13 * (1. + (RH/11.6)@2) * exp(-3950./T) * jno2 )
SHONO = CONST(HV_in*2.6*1.1*0.7)

; HCHO Quelle (licht abhï¿½ngig, photochemie unabhï¿½ngig)
SHCHO --> HCHO
k[SHCHO --> HCHO] = CONST(2.8e6)
SHCHO = CONST(HV_in*1)
 
*********************************************************************
 
;/BGREAC, Background reactivity (see saphir.bgreac.incl) 
Y + OH --> HO2
k[Y + OH --> HO2]=CONST(2.4e-13)
;Y + OH --> CH3O2
;k[Y + OH --> CH3O2]=CONST(2.4e-13)
Y=CONST(230e-9*M) ; Y in CO ï¿½quivalenten
 
