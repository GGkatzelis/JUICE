;;;;;;;;;;;;;;;;;;;;;;;;;;;;;shared_Chloride_inoganic.incl;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
CLNO2+HV-->CL+NO2
CL2+HV-->2*CL
CLONO2+HV-->NO3+CL
CLONO2+HV-->NO2+CLO
CL+O3-->CLO
CL+HO2-->HCL
CL+HO2-->CLO+OH
CL+H2O2-->HCL+HO2
CL+NO3-->NO2+CLO
CL+CLONO2-->CL2+NO3
CL+CO-->CLCO
OH+HCL-->CL+H2O
OH+CL2-->HOCL+CL
OH+HOCL-->CLO+H2O
OH+CLO-->0.9375*HO2+0.9375*CL+0.0625*HCL
CLO+NO2-->CLONO2
CLO+NO-->CL+NO2
CLO+HO2-->HOCL
CLCO-->CL+CO
CLCO-->CLCO3
CLCO3+CLCO3-->2*CLCO2
CLCO2-->CL+CO2
DIL+HCL-->
DIL+CLNO2-->
DIL+CL2-->
DIL+CL-->
DIL+CLO-->
DIL+HOCL-->
DIL+CLONO2-->
DIL+CLCO-->
k[CLNO2+HV-->CL+NO2]=CONST(jclno2)
k[CL2+HV-->2*CL]=CONST(jcl2)
k[CLONO2+HV-->NO3+CL]=CONST(jclono2 * 0.83)
k[CLONO2+HV-->NO2+CLO]=CONST(jclono2 * 0.17)
k[CL+O3-->CLO]=CONST(2.3e-11*exp(-200./T))
k[CL+HO2-->HCL]=CONST(1.4e-11*exp(270./T))
k[CL+HO2-->CLO+OH]=CONST(3.6e-11*exp(-375./T))
k[CL+H2O2-->HCL+HO2]=CONST(1.1e-11*exp(-980./T))
k[CL+NO3-->NO2+CLO]=CONST(2.4e-11)
k[CL+CLONO2-->CL2+NO3]=CONST(6.2e-12*exp(145./T))
k[CL+CO-->CLCO]=CONST(1.30000e-033*(T/300.)@(-3.8)*M)
k[OH+HCL-->CL+H2O]=CONST(1.7e-12*exp(-230./T))
k[OH+CL2-->HOCL+CL]=CONST(3.6e-12*exp(-1200./T))
k[OH+HOCL-->CLO+H2O]=CONST(5.0e-13)
k[OH+CLO-->0.9375*HO2+0.9375*CL+0.0625*HCL]=CONST(1.92e-11)
k[CLO+NO2-->CLONO2]=TROE(1.80D-031,3.40000,1.50D-11,1.900000)
k[CLO+NO-->CL+NO2]=CONST(6.4e-12*exp(290./T))
k[CLO+HO2-->HOCL]=CONST(2.6e-12*exp(290./T))
k[CLCO-->CL+CO]=CONST(4.9e5)
k[CLCO-->CLCO3]=CONST(4.3e-13*O2)
k[CLCO3+CLCO3-->2*CLCO2]=CONST(5e-12)
k[CLCO2-->CL+CO2]=CONST(2e10)
k[DIL+HCL-->]=CONST(DILUTE)
k[DIL+CLNO2-->]=CONST(DILUTE)
k[DIL+CL2-->]=CONST(DILUTE)
k[DIL+CL-->]=CONST(DILUTE)
k[DIL+CLO-->]=CONST(DILUTE)
k[DIL+HOCL-->]=CONST(DILUTE)
k[DIL+CLONO2-->]=CONST(DILUTE)
k[DIL+CLCO-->]=CONST(DILUTE)
k[DIL+CLCO3-->]=CONST(DILUTE)
k[DIL+CLCO2-->]=CONST(DILUTE)
