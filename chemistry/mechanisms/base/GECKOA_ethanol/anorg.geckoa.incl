; ---- functions (the same copy stands in every GECKO-A include; identical, last definition wins) ----
AMAX =FUNCTION[AMAX(%1,%2)]
AMIN =FUNCTION[AMIN(%1,%2)]
COSX=CONST(COS(SZ*0.0174533))
; GTROE(k0*M, kinf, Fc) = standard Troe form of boxmodel4gecko forate (flag 0)
GTROE = FUNCTION[((%1)/(1.+(%1)/(%2)))*((%3)@(1./(1.+(LOG10((%1)/(%2)))@2.)))]
; GPHOT(l_ratio, dm, -dn, anchor, hvfact) = GECKO-A J ratio l_ratio*cos^dm*exp(-dn*sec) x measured anchor x hvfact
GPHOT = FUNCTION[((%1)*((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))*(%4)*(%5)]

; ---- rate parameters (inorganic core: Troe falloff, EXTRA helpers, GPHOT photolysis) ----
