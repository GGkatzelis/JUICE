k[C5HYDCARBOOH+hv-->MALDALCO2H+OH+CH3O2]=CONST(J41)
k[DIMEFURAN+OH-->C4DBDIKET+HO2]=CONST(1.32D-10*0.27)
k[DIMEFURAN+OH-->HYDDIMEFURANO2]=CONST(1.32D-10*0.73)
k[HYDDIMEFURANO2+NO-->C5CO14OH+NO2+CH3O2]=CONST(KRO2NO)
