M3F + NO3  -->  PPM3FURAN

; ---- rates ----
k[FURAN+OH-->MALDIAL+HO2]=CONST(4.2D-11*0.7)
k[FURAN+OH-->HYDFURANO2]=CONST(4.2D-11*0.3)
k[HYDFURANO2+NO-->MALDALCO2H+NO2+HO2]=CONST(KRO2NO)
k[HYDFURANO2+HO2-->HYDFURANOOH]=CONST(KRO2HO2)
k[HYDFURANOOH+hv-->MALDALCO2H+OH]=CONST(J41)
k[HYDFURANOOH+OH-->MALDALCO2H+OH]=CONST(4D-11)
k[HYDFURANO2-->MALDALCO2H+HO2]=CONST(5D-13*RO2)
k[M2F+OH-->C5DICARB+HO2]=CONST(6.19D-11*0.31)
