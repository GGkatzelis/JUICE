; ---- MCM reactions re-rated by this extension (last definition wins) ----
; was J<19>
k[BENZAL+hv-->C6H5CO3+HO2]=CONST(JN2*0.5)
; was J<18>
k[BENZAL+hv-->C6H5O2+CO+HO2]=CONST(JN2*0.5)
