;TITLE=scene_03 , simple CO chemistry, lights on and off
  
; INCLUDES: 
#include default_minimum.incl     ; simple functions
#include anorg.mcm331.dark.rate   ; dark anorganic reactions
#include anorg.mcm331.dark.mech   ; rate constants of dark reactions
#include anorg.mcm331.phot.rate   ; anorganic photolysis reactions
#include anorg.mcm331.phot.mech   ; anorganic photolysis frequencies
#include j_clear_sky.incl
 
*********************************************************************
 
;/WALLDEP, Wall deposition in SAPHIR chamber
;#include saphir.walldep.incl
;WALLDEP   = CONST(1.) ; Switch fuer die Wandverluste 
 
*********************************************************************
 
;/SOURCE, HONO and HCHO source of SAPHIR chamber

; Funktion die die Wasserkonzentration in die relative
; Feuchtigkeit umrechnet
WVC2RH     =FUNCTION[%1*100./(exp(21.36469-5339.66/T)/P*M)]

; Relative Feuchtigkeit
RH = WVC2RH(H2O)

; HONO Quelle aus Paper Rohrer et al.
;SHONO --> HONO
;k[SHONO --> HONO]  = CONST( 4.7e13 * (1. + (RH/11.6)@2) * exp(-3950./T) * jno2 )
;SHONO = CONST(HV_in*2.6*1.1)

; HCHO Quelle (licht abh�ngig, photochemie unabh�ngig)
;SHCHO --> HCHO
;k[SHCHO --> HCHO] = CONST(2.8e6)
;SHCHO = CONST(HV_in*1)
 
*********************************************************************
 
;/BGREAC, Background reactivity (see saphir.bgreac.incl) 
;Y + OH --> HO2
;k[Y + OH --> HO2]=CONST(2.4e-13)
;;Y + OH --> CH3O2
;;k[Y + OH --> CH3O2]=CONST(2.4e-13)
;Y=CONST(230e-9*M) ; Y in CO �quivalenten
 
*********************************************************************
 
; DILUTION, /DIL
;#include ethanol.fac.dil.mech ;dilution mechanism
;#include ethanol.fac.dil.rate ;dilution rate
#include anorg.fac.dil.mech
#include anorg.fac.dil.rate

DILUTE = CONST((FLOW+0.010*60)/(276.*3600.))
FLOW   = CONST(6.)  ; Experimetal flow in m^3/h
;DIL    = CONST(0)   ; Switch for dilution
DIL    = input(DIL)
 
; Water as a variable 
;INITIAL[H2O] = CONST(M*0.01)
 
*********************************************************************
 
;/MEASURED, use measured photolysis frequencies (given in ENZ-file)
;           and other measured parameters]
#include saphir.jmeasured_02.incl ; definitions for further use of jno2
                              ; and jo1d as scaling factors of other 
                              ; photolysis frequencies
k[NO2 + hv --> O3 + NO]      = CONST( jno2 )
jno2 = PHTFKT_CS(1.165D-02,0.244,-0.267)

T    = INPUT(t)       ; temperature in K
P    = CONST(1000)    ; pressure in hPa
SZA  = CONST(30)      ; solar zenith angle
SZ   = CONST(30)      ; solar zenith angle
HV   = INPUT(hv)      ; switch for light
FLOW = CONST(10)      ; flow into the chamber in m^3/h
*********************************************************************
; FILES: 
FILES[ENZ]   = scene_03.enz
 
; FACSIMILE PARAMETERS
FACS[HMAX]   = 10
FACS[OUTSTEP]= 10
 
; INITIALS:
INITIAL[*]   = CONST(0)
INITIAL[NO2] = CONST(M*1e-9*10)
INITIAL[CO]  = CONST(M*1e-9*2500)
INITIAL[H2O] = CONST(M*1e-2*1)

NO+O3-/->NO2
O3+NO-->NO2
