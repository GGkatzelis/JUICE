**;

COMPILE in;
 CALL parset;
 CALL parset;
 CALL parset;
 DO 97 FOR #49=4,#88=9;
 ENTER input;
 LABEL 97;
 IF (tnull-1.e25) 98, *, *;
 tnull=input<0>;
 LABEL 98;
 WRITE 1=6, "t(input)=" ,input<0> %;
 IF (input<0>-tnull) *,99,99;
 fertig=1;
 CLOSE 9;
 CALL table;
 STOP;
 LABEL 99;
