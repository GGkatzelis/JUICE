COSX=CONST(COS(SZ*0.0174533))
LNO2=CONST(1.165D-02)
MNO2=CONST(0.244)
NNO2=CONST(-0.267)
PHTFKT = FUNCTION[HV*( ((%1)* ((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))* (AMIN((jno2 / (LNO2*((AMAX(COSX,0.01))@MNO2) * exp(NNO2/AMAX(COSX,0.01))) ),1.)) )]
PHTFKT_CS= FUNCTION[(%1)*((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01))]
J1_cs = PHTFKT_CS(6.073D-05,1.743,-0.474)
J4_cs = PHTFKT_CS(1.165D-02,0.244,-0.267)
