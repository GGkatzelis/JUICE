;anorganic
k[NO3+hv-->NO]      = PHOTMMSC(2.485e-2,0.168,0.108,1.165e-2,0.244,0.267,jno2)
k[NO3+hv-->NO2+O3]  = PHOTMMSC(1.747e-1,0.155,0.125,1.165e-2,0.244,0.267,jno2)
k[HNO3+hv-->OH+NO2] = PHOTMMSC(9.312e-7,1.230,0.307,1.165e-2,0.244,0.267,jno2)

;organic
