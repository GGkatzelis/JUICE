;------------------------------------------------------------------
; gemessenes J
; Benötigte Funktionen
AMAX =FUNCTION[AMAX(%1,%2)]
AMIN =FUNCTION[AMIN(%1,%2)]

ARRH=FUNCTION[(%1)*exp((%2)/T)] 

; geändert F.Rohrer 16.07.2023
;PHOTMMSC=FUNCTION[(%1)*COS(AMIN(SZA,89.9)*3.141593/180)@(%2)*       $
;                  exp(-1.*(%3)/COS(AMIN(SZA,89.9)*3.141593/180))*   $
;                  AMIN(1+5*COS(AMIN(SZA,89.9)*3.141593/180),   $
;                  (%7)/((%4)*COS(AMIN(SZA,89.9)*3.141593/180)@(%5)*  $
;                  exp(-1.*(%6)/COS(AMIN(SZA,89.9)*3.141593/180))))]

PHOTMMSC= FUNCTION[((%1)* ((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))* (AMIN(((%7) / ((%4)*((AMAX(COSX,0.01))@(%5)) * exp((%6)/AMAX(COSX,0.01))) ),1.))]
PHTFKT  = FUNCTION[((%1)* ((AMAX(COSX,0.01))@(%2))*EXP((%3)/AMAX(COSX,0.01)))* (AMIN((jno2 / (LNO2*((AMAX(COSX,0.01))@MNO2) * exp(NNO2/AMAX(COSX,0.01))) ),1.))]

hv + NO2 -/-> O + NO 
NO2 + hv --> O3 + NO

HV + O3 -/-> O

NO3 + hv -/-> NO2 + O
NO3 + hv--> NO2 + O3

HNO3 + hv --> OH + NO2 

