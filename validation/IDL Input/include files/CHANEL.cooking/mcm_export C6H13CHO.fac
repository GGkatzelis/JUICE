% KRO2NO3 : C2H5O2 + NO3 = C2H5O + NO2 ;
% 4.3D-13*EXP(870/TEMP) : C2H5O2 + HO2 = C2H5OOH ;
% 2*(KCH3O2*6.4D-14)@(0.5)*RO2*0.6 : C2H5O2 = C2H5O ;
% 2*(KCH3O2*6.4D-14)@(0.5)*RO2*0.2 : C2H5O2 = CH3CHO ;
% 2*(KCH3O2*6.4D-14)@(0.5)*RO2*0.2 : C2H5O2 = C2H5OH ;
