 COMPILE parset;                                                         

  LOCN   INSTRUCTION

   166:s<0,0>=input<1>;                                                        
   172:s<1,0>=(295);                                                           
   178:s<2,0>=(1013);                                                          
   184:* convert to mixing ratios;                                             
   184: DO 50 FOR #1=0 (1) #nbox-1;                                            
   201: ARRAY <#nvar> worksp;                                                  
   204: c<*,#1>=c<*,#1>/s<3,#1>;                                               
