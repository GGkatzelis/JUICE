                           ENCOUNTERED            1
                           ALLOWED HENCEFORTH    20

   217: LABEL 50;                                                              
   262:s<3,0>=((s<2,0>))/(((s<1,0>))*1.379E-19);                               
   275:* convert back to conc;                                                 
   275: DO 51 FOR #1=0 (1) #nbox-1;                                            
   292: ARRAY <#nvar> worksp;                                                  
   295: c<*,#1>=c<*,#1>*s<3,#1>;                                               
   306: ARRAY end;                                                             

 MAXIMUM NESTING DEPTHS:   ALLOWED SO FAR        11
                           ENCOUNTERED            1
                           ALLOWED HENCEFORTH    20

   308: LABEL 51;                                                              
   353:s<4,0>=(1);                                                             
   359:s<5,0>=(150/275/3600);                                                  
   371:s<6,0>=(c<0,0>/s<3,0>*1e9);                                             
   383:s<7,0>=(c<1,0>/s<3,0>*1e9);                                             
   395:ARRAY <#nbox> worksp;                                                   
   398:k<0,*>=(s<5,*>);                                                        
   406:k<1,*>=(s<3,*>*1e-9/60*1);                                              
   423:k<2,*>=(s<3,*>*1e-9/60*1);                                              
   440:ARRAY end;                                                              

