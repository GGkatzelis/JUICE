 INTEGER #nvar 2;                                                        
 INTEGER #nbox 1;                                                        
 INTEGER #nreac 3;                                                       
 INTEGER #nset 8;                                                        
 TEXT #title "TITLE";                                                    
                                                                         
 KMAX 3;                                                                 
 SETRS 25;                                                               
                                                                         
 VARIABLE <#nvar,#nbox> c 2*1.;                                          
 PARAMETER <22> worksp;                                                  
