* Facsimile-Script / EASY Ver. 5.96b 2010-5-19;
* Fri Apr 10 23:34:57 2026;

INTEGER #nvar 2;
INTEGER #nbox 1;
INTEGER #nreac 3;
INTEGER #nset 8;
TEXT #title "TITLE";

KMAX 3;
SETRS 25;

VARIABLE <#nvar,#nbox> c 2*1.;
PARAMETER <22> worksp;
PARAMETER <#nvar,#nbox> sc 2*1.;
PARAMETER <#nvar,#nbox> p 2*0.;
PARAMETER <#nvar,#nbox> d 2*0.;
PARAMETER <#nreac,#nbox> v 3*0.;
PARAMETER <#nreac,#nbox> k 3*1.e-20;
PARAMETER <#nset,#nbox> s 8*1.;
PARAMETER h;
PARAMETER tread -1E25;
PARAMETER zeitflag ;
PARAMETER zeitschwelle;
PARAMETER zsgn -1;
PARAMETER zeitintervall 10;
PARAMETER tout;
PARAMETER tnull 1E25;
PARAMETER <3>input 1E25;
PARAMETER fertig 0.0;

COMPILE initial;
 HMAX 5.0000000;
 FOR #99=0;
 OPEN 9 "scene_01.enz";
 DO 21 FOR #88=9;
 ENTER;
 LABEL 21;
 WRITE 1=6, "start reading from input file";
 CALL in;
 CALL init2;
 time = tread;
 CALL zeitsprung;
 CALL in;
 OPEN 14 "scene_01.hd";
 DO 16 FOR #88=14;
 OPEN 10 "scene_01.cs";
 DO 12 FOR #87=10;
 ENTER;
 LABEL 12;
 OPEN 11 "scene_01.kv";
 DO 13 FOR #87=11;
 ENTER;
 LABEL 13;
 OPEN 12 "scene_01.pd";
 DO 14 FOR #87=12;
 ENTER;
 LABEL 14;
 LABEL 16;
 CLOSE 14;
**;

COMPILE parset;
s<0,0>=input<1>;
s<1,0>=(295);
s<2,0>=(1013);
* convert to mixing ratios;
 DO 50 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>/s<3,#1>;
 ARRAY end;
 LABEL 50;
s<3,0>=((s<2,0>))/(((s<1,0>))*1.379E-19);
* convert back to conc;
 DO 51 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>*s<3,#1>;
 ARRAY end;
 LABEL 51;
s<4,0>=(1);
s<5,0>=(150/275/3600);
s<6,0>=(c<0,0>/s<3,0>*1e9);
s<7,0>=(c<1,0>/s<3,0>*1e9);
ARRAY <#nbox> worksp;
k<0,*>=(s<5,*>);
k<1,*>=(s<3,*>*1e-9/60*1);
k<2,*>=(s<3,*>*1e-9/60*1);
ARRAY end;
**;

COMPILE init2;
 CALL parset;
 CALL parset;
 CALL parset;
 c<0,0>=(0);
 c<1,0>=(0);
 DO 47 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>/sc<*,#1>;
 ARRAY end;
 LABEL 47;
**;

COMPILE print;
 CALL table;
 IF (tread-time) *,*,65;
 CALL in;
 LABEL 65;
 CALL zeitsprung;
 zsgn = -zsgn;
 RESTART;
**;

COMPILE table;
 tout = time + tnull;
 DO 48 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>*sc<*,#1>;
 ARRAY end;
 LABEL 48;
 DO 50 FOR #50=#nvar,#51=#nbox,#52=#nset,#53=#nbox,#54=10;
 ENTER tout c s ;
 LABEL 50;
 DO 49 FOR #1=0 (1) #nbox-1;
 ARRAY <#nvar> worksp;
 c<*,#1>=c<*,#1>/sc<*,#1>;
 ARRAY end;
 LABEL 49;
 DO 51 FOR #50=#nreac,#51=#nbox,#52=#nreac,#53=#nbox,#54=11;
 ENTER tout k v ;
 LABEL 51;
 DO 52 FOR #50=#nvar,#51=#nbox,#52=#nvar,#53=#nbox,#54=12;
 ENTER tout p d ;
 LABEL 52;
 IF <#98> 54,54,*;
 fertig=1;
 LABEL 54;
**;

COMPILE general;
 zeitflag=(zeitschwelle-time)*zsgn;
**;

COMPILE equations;
* from compile parset;
s<6,0>=(c<0,0>/s<3,0>*1e9);
s<7,0>=(c<1,0>/s<3,0>*1e9);
 ARRAY <#nbox> worksp;
v<0,*>=k<0,*>*s<4,*>*c<1,*>;
v<1,*>=k<1,*>*s<0,*>;
v<2,*>=k<2,*>*s<0,*>;
p<0,*>=v<1,*>;
p<1,*>=v<2,*>;
d<0,*>=0;
d<1,*>=v<0,*>;
 ARRAY <#nvar,#nbox> worksp;
 'c=p-d;
 ARRAY end;
**;

COMPILE zeitsprung;
 h=zeitschwelle+zeitintervall;
 zeitschwelle=AMIN(h,tread);
**;

COMPILE in;
 CALL parset;
 CALL parset;
 CALL parset;
 DO 97 FOR #49=3,#88=9;
 ENTER input;
 LABEL 97;
 IF (tnull-1.e25) 98, *, *;
 tnull=input<0>;
 LABEL 98;
 WRITE 1=6, "t(input)=" ,input<0> %;
 IF (input<0>-tnull) *,99,99;
 fertig=1;
 CLOSE 9;
 CALL table;
 STOP;
 LABEL 99;
 tread=input<0>-tnull;
**;

WHENEVER fertig=1 %;
 zeitflag=0 CALL print;
**;

BEGIN;
STOP;

