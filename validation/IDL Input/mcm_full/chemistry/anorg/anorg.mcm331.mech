; Anorganische Reaktionen, die auch im Dunkeln ablaufen
; Nach MCM 3.1
; Erstellt von Cornelia Richter, Dezember 2004
; Updated to MCMv3.2 by Keding Lu, March 2011
; Updated to MCMv3.3 by Xin Li, April 2015
; Updated to MCMv3.3.1 by Xin Li, April 2016
 
 O --> O3
 O + O3 -->
 O + NO	--> NO2
 O + NO2 --> NO
 O + NO2 --> NO3
 O1D -->  O
 NO + O3 --> NO2
 NO2 + O3 --> NO3
 NO + NO --> NO2 + NO2
 NO + NO3 --> NO2 + NO2
 NO2 + NO3 --> NO + NO2
 NO2 + NO3 --> N2O5
 N2O5 --> NO2 + NO3
 O1D --> OH + OH
 OH + O3 --> HO2
 OH + H2 --> HO2
 OH + CO --> HO2 + CO2
 OH + H2O2 --> HO2
 HO2 + O3 --> OH
 OH + HO2 -->
 HO2 + HO2 --> H2O2
 OH + NO --> HONO
 OH + NO2 --> HNO3
 OH + NO3 --> HO2 + NO2
 HO2 + NO --> OH + NO2
 HO2 + NO2 --> HO2NO2
 HO2NO2 --> HO2 + NO2
 OH + HO2NO2 --> NO2
 HO2 + NO3 --> OH + NO2
 OH + HONO --> NO2
 OH + HNO3 --> NO3
 O + SO2 --> SO3
 OH + SO2 --> HSO3
 HSO3 --> HO2 + SO3
 
; newly added since MCMv3.2
 HNO3 --> NA 
 N2O5 --> NA + NA 
 SO3 --> SA 
 
; Inorganic photolysis reactions
O3    + hv  --> O1D
O3    + hv  --> O
H2O2  + hv  --> OH  + OH
NO2   + hv  --> NO  + O
NO3   + hv  --> NO
NO3   + hv  --> NO2 + O
HONO  + hv  --> OH  + NO
HNO3  + hv  --> OH  + NO2