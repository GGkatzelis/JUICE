;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
qVOC=input(QVOC)

k[VOCin1+DIL-->]=CONST(0)
k[VOCin2+DIL-->]=CONST(0)
k[qVOCin_all+DIL-->]=CONST(0)

qVOC-->0.9*VOCin1+0.1*VOCin2
k[qVOC-->0.9*VOCin1+0.1*VOCin2]=CONST(M*1e-9/60*23.34)

VOCin1-->qVOCin_all
k[VOCin1-->qVOCin_all]=CONST(1./60)
VOCin2-->qVOCin_all
k[VOCin2-->qVOCin_all]=CONST(1./1800)
  qVOCin_all=input(QVOC)
  qVOCin_all-->0.092669*CH3CHO+0.060555*BENZENE+0.242439*C2H5OH+0.146659*NC12H26+0.089599*TOLUENE+0.044085*PXYL+0.032659*OXYL+0.067681*MXYL+0.021637*TM124B+0.009209*CPENT2ENE+0.192807*IC5H12
k[qVOCin_all-->0.092669*CH3CHO+0.060555*BENZENE+0.242439*C2H5OH+0.146659*NC12H26+0.089599*TOLUENE+0.044085*PXYL+0.032659*OXYL+0.067681*MXYL+0.021637*TM124B+0.009209*CPENT2ENE+0.192807*IC5H12]=CONST(M*1e-9/60*23.34)

;qVOCin_all-->CO
;k[qVOCin_all-->CO]=CONST(1./60)

q_C2H4=input(Q_C2H4)
q_C2H4-->C2H4
k[q_C2H4-->C2H4]=CONST(M*1e-9/60*11)   ; MFC2 at 0.05 lpm for a 10% bottle for 36s
;08:57 X R.T. CHANGE: Injection of 11 ppbv of ethylene using MFC2 at 0.05 lpm for a 10% bottle for 36 s

q_C3H6=input(Q_C3H6)
q_C3H6-->C3H6
k[q_C3H6-->C3H6]=CONST(M*1e-9/60*6)    ; MFC2 at 0.25 lpm for a 1% bottle for 40s
;09:12 X R.T. CHANGE: Injection of 6 ppbv of propene using MFC2 at 0.25 lpm for a 1% bottle for 40 s

q_TBUT2ENE=input(Q_TBUT2ENE)
q_TBUT2ENE-->TBUT2ENE
k[q_TBUT2ENE-->TBUT2ENE]=CONST(M*1e-9/60*1)   ; MFC2 at 0.25 lpm for a 1% bottle for 40s
;09:26 X G.G. CHANGE: Injection of 1 ppbv of trans-2-butene using 0.32 ml injection for around 1 ppbv from a pure bottle

q_C4H6=input(Q_C4H6)
q_C4H6-->C4H6
k[q_C4H6-->C4H6]=CONST(M*1e-9/60*1.16)   ; 0.32 ml injection for around 1 ppbv from a pure bottle
;09:32 X G.G. CHANGE: Injection of 1 ppbv of 1,3-butadiene using 0.32 ml injection for around 1 ppbv from a pure bottle

q_MEPROPENE=input(Q_MEPROPENE)
q_MEPROPENE-->MEPROPENE
