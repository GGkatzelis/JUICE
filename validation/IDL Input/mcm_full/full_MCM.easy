;09:45 X R.T. CHANGE: Injection of 1.5 ppbv of isobutene using MFC2 at 0.25 lpm for a 1% bottle for 50 s

;qVOC2-->NO+XNOy
;k[qVOC2-->NO+XNOy]=CONST(M*1e-9/60*0.01)

TROE=FUNCTION[ M*(%1)*(T/300.)@((-1.)*(%2))/(1.+M*(%1)*(T/300.)@((-1.)*(%2))/((%3)*(T/300.)@((-1.)*(%4))))*0.6@(1./(1.+(log10(M*(%1)*(T/300.)@((-1.)*(%2))/((%3)*(T/300.)@((-1.)*(%4)))))**2)) ]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
X_limonene+DIL-->
k[X_limonene+DIL-->]=CONST(DILUTE)

X_limonene-->
k[X_limonene-->]=CONST(1/(3600*20))

gamma_limonene=CONST(0.25)
k[LIMONENE+O3-->LIMOOA]=CONST(2.80D-15*EXP(-770/(T))*0.730*(1-gamma_limonene))
k[LIMONENE+O3-->LIMOOB]=CONST(2.80D-15*EXP(-770/(T))*0.270*(1-gamma_limonene))
LIMONENE+O3-->SOA_LIM_O3
k[LIMONENE+O3-->SOA_LIM_O3]=CONST(2.80D-15*EXP(-770/(T))*gamma_limonene)

k[LIMONENE+OH-->LIMAO2]=CONST(4.28D-11*EXP(401/(T))*0.408*(1-gamma_limonene))
k[LIMONENE+OH-->LIMBO2]=CONST(4.28D-11*EXP(401/(T))*0.222*(1-gamma_limonene))
k[LIMONENE+OH-->LIMCO2]=CONST(4.28D-11*EXP(401/(T))*0.370*(1-gamma_limonene))
LIMONENE+OH-->SOA_LIM_OH
k[LIMONENE+OH-->SOA_LIM_OH]=CONST(4.28D-11*EXP(401/(T))*gamma_limonene)

k[LIMONENE+NO3-->NLIMO2]=CONST(1.22D-11*(1-gamma_limonene))
LIMONENE+NO3-->SOA_LIM_NO3
k[LIMONENE+NO3-->SOA_LIM_NO3]=CONST(1.22D-11*gamma_limonene)

gamma_dodecane=CONST(0.12)
k[NC12H26+OH-->DDECO2]=CONST(1.39D-11*(1-gamma_dodecane)/2.2)
NC12H26+OH-->SOA_NC12H26_OH
k[NC12H26+OH-->SOA_NC12H26_OH]=CONST(1.39D-11*gamma_dodecane/2.2)
SOA_NC12H26_OH-->
k[SOA_NC12H26_OH-->]=CONST(1/(3600*SOA_decay))
SOA_NC12H26_OH+DIL-->
k[SOA_NC12H26_OH+DIL-->]=CONST(DILUTE)

SOA_decay=CONST(10)
SOA_LIM_O3-->
k[SOA_LIM_O3-->]=CONST(1/(3600*SOA_decay))
SOA_LIM_O3+DIL-->
k[SOA_LIM_O3+DIL-->]=CONST(DILUTE)

SOA_LIM_OH-->
k[SOA_LIM_OH-->]=CONST(1/(3600*SOA_decay))
SOA_LIM_OH+DIL-->
k[SOA_LIM_OH+DIL-->]=CONST(DILUTE)

SOA_LIM_NO3-->
k[SOA_LIM_NO3-->]=CONST(1/(3600*SOA_decay))
SOA_LIM_NO3+DIL-->
k[SOA_LIM_NO3+DIL-->]=CONST(DILUTE)

SOA_seed-->
k[SOA_seed-->]=CONST(1/(3600*SOA_decay))
SOA_seed+DIL-->
k[SOA_seed+DIL-->]=CONST(DILUTE)

Q_seed=input(Q_seed)
Q_seed-->SOA_seed
k[Q_seed-->SOA_seed]=CONST(M*1e-9/60/(136*2.3/48*1.97)*0.57)
INITIAL[SOA_seed]=CONST(M*1e-9/(136*2.3/48*1.97)*0.0) 

SOA=CONST(SOA_seed+SOA_LIM_NO3+SOA_LIM_O3+SOA_LIM_OH)

KMT17   = CONST(0)


