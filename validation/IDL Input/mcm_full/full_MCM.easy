k[qNO-->NO+XNOy]=CONST(M*1e-9/60*6.6)

qNO-->NO2+XNOy
k[qNO-->NO2+XNOy]=CONST(M*1e-9/60*0.1)

;qNO-->HONO+XNOy
;k[qNO-->HONO+XNOy]=CONST(M*1e-9/60*0.0)

;qH2O-->H2O
