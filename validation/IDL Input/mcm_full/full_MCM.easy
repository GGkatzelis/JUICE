;k[qH2O-->H2O]=CONST(M*1e-2/60*9)

qH2O=input(QH2O)
qH2O-->HONO+XNOy
k[qH2O-->HONO+XNOy]=CONST(M*1e-9/60*0.05)
qH2O-->CO
k[qH2O-->CO]=CONST(M*1e-9/60*0.5)

qH2O-->NO2+XNOy
k[qH2O-->NO2+XNOy]=CONST(M*1e-9/60*0.1)
qH2O-->NO+XNOy
k[qH2O-->NO+XNOy]=CONST(M*1e-9/60*0.0)

H2O-->HONO+XNOy
k[H2O-->HONO+XNOy]=CONST(1e-012/2)

qO3-->O3
qO3=input(QO3)
k[qO3-->O3]=CONST(M*1e-9/60*113*0)

;O3=CONST(M*50e-9)
;C5H8=CONST(M*1e-9)

SNO2 --> NO2+XNOy
;k[SNO2 --> NO2+XNOy]  = CONST(jno2/5e-3*1e-9*M/3600*HV_in*0.55)
;SNO2=CONST(1)
k[SNO2 --> NO2+XNOy]  = CONST(jno2/5e-3/3600*HV_in/1.6*0.55)
INITIAL[SNO2] = CONST(M*1e-9*3.5*0)

