;TITLE=2024-08-05 Experiment 23: LA+biogenics+O3 Daytime Oxidation at Low NOx!C!Cinjection into SAPHIR : LA+biogenics
;2024-08-05.SAPHIR.MCM.FZJ.LA+biogenics_SOA_wo.easy  
; This is a temporary EASY-Input File written by mcm331cv.pro
; with input file chanel.all_mixes.fac
;   
; To make this file a working EASY-Input File, the following
; steps have to be done at least: 
;   1) Fill in the INITIAL values (and water concentration)
;   2) Make sure that EASY will find the included files
;   3) Save the new file with a DOS compatible name
   
; INCLUDES: 
#include anorg.mcm331.dark.rate   ; dark anorganic reactions
#include anorg.mcm331.dark.mech   ; rate constants of dark reactions
#include anorg.mcm331.phot.rate   ; anorganic photolysis reactions
#include anorg.mcm331.phot.mech   ; anorganic photolysis frequencies
#include chanel.all_mixes.fac.saphir.incl ; MCM3-spezific constants and functions 
#include chanel.all_mixes.fac.ro2.incl ; RO2 species
#include chanel.all_mixes.fac.mech ; reaction mechanism for given VOC
#include chanel.all_mixes.fac.rate ; rate constants for given VOC reactions
#include j_clear_sky.incl
*********************************************************************
 
;/WALLDEP, Wall deposition in SAPHIR chamber
#include saphir.walldep.incl
WALLDEP   = CONST(1.) ; Switch fuer die Wandverluste 
 
*********************************************************************
 
;/SOURCE, HONO and HCHO source of SAPHIR chamber

; Funktion die die Wasserkonzentration in die relative
; Feuchtigkeit umrechnet
WVC2RH     =FUNCTION[%1*100./(exp(21.36469-5339.66/T)/P*M)]

; Relative Feuchtigkeit
RH = WVC2RH(H2O)

; HONO Quelle aus Paper Rohrer et al.
SHONO+HV --> HONO+XNOy
k[SHONO+HV --> HONO+XNOy]  = CONST( 4.7e13 * (1. + (RH/11.6)@2) * exp(-3950./T) * jno2 )
SHONO = CONST(2.6*0.7)

; HCHO Quelle (lichtabhängig, photochemie unabhängig)
qSHCHO+HV --> HCHO
k[qSHCHO+HV --> HCHO] = CONST(2.8e6)
SHCHO = CONST(1)
 
*********************************************************************
 
;/BGREAC, Background reactivity (see saphir.bgreac.incl) 
;qY + OH --> HO2
;k[qY + OH --> HO2]=CONST(2.4e-13)
qY + OH --> CH3O2
k[qY + OH --> CH3O2]=CONST(2.4e-13)
qY=CONST(250e-9*M) ; Y in CO Äquivalenten
 
*********************************************************************
 
; DILUTION, /DIL
#include chanel.all_mixes.fac.dil.mech ;dilution mechanism
#include chanel.all_mixes.fac.dil.rate ;dilution rate
;FLOW   = CONST(6.)  ; Experimetal flow in m^3/h
DILUTE = CONST((FLOW+0.010*60)/(276.*3600.))
DIL    = CONST(1.) ; Switch for dilution
 
; Water as a variable 
;INITIAL[H2O] = CONST(1.4e-2*M)
 
*********************************************************************
 
;/MEASURED, use measured photolysis frequencies (given in ENZ-file)
;           and other measured parameters]
#include saphir.jmeasured_02.incl ; definitions for further use of jno2
                              ; and jo1d as scaling factors of other 
                              ; photolysis frequencies
jno2 = INPUT(jno2)
k[NO2 + HV --> O3 + NO]      = CONST( jno2 )
jo1d = INPUT(jo1d)
k[O3 + HV --> O1D ]          = CONST( jo1d )
jhcho_m                      = INPUT(jhcho_m)
k[HCHO + HV --> H2 + CO ]    = CONST(jhcho_m)
jhcho_r                      = INPUT(jhcho_r)
k[HCHO + HV --> 2*HO2 + CO ] = CONST(jhcho_r)
jh2o2                        = INPUT(jh2o2)
k[H2O2 + HV --> 2*HO]        = CONST(jh2o2)
jhono                        = INPUT(jhono)
k[HONO + HV --> OH + NO]     = CONST(jhono)

T_in = INPUT(t)
T    = CONST(T_in)    ; temperature in K
P    = CONST(1006.5)  ; pressure in hPa
SZA  = INPUT(sz)      ; solar zenith angle
SZ   = INPUT(sz)      ; solar zenith angle
HV_in= INPUT(hv)      ; switch for light
HV   = CONST(HV_in)
FLOW = INPUT(dilute)  ; flow into the chamber in m^3/h
H2O_in = INPUT(H2O)   ; mixing ratio of water
H2O = CONST(1e-2*M*H2O_in)
*********************************************************************
 
; FILES: 
FILES[ENZ]   = scene_09.enz
 
; FACSIMILE PARAMETERS
FACS[HMAX]   = 30
FACS[OUTSTEP]= 100000
 
; INITIALS:
INITIAL[*] = CONST(1.) 
;INITIAL[O3] = CONST(M*1e-9*1.5) 
INITIAL[CO] = CONST(M*1e-9*14.0) 
INITIAL[CO2]= CONST(M*1e-6*0.25*0) 
INITIAL[NO2]= CONST(M*1e-9*0.00) 

XNOy+DIL-->
k[XNOy+DIL-->]=CONST(DILUTE)

NA+DIL-->
k[NA+DIL-->]=CONST(DILUTE)

XNOy+DIL-->
k[XNOy+DIL-->]=CONST(DILUTE)

NA+DIL-->
k[NA+DIL-->]=CONST(DILUTE)

;qCO2-->CO2
;qCO2=input(QCO2)
;qCO2=CONST(1)
;k[qCO2-->CO2]=CONST(M*1e-6/3600*0.01)

;qCO2-->CO
;qCO2=input(QCO2)
;k[qCO2-->CO]=CONST(M*1e-9/60*60)

;qNO-->NO+XNOy
;qNO=input(QNO)
;k[qNO-->NO+XNOy]=CONST(M*1e-9/60*0.0)

;qNO2-->NO2+XNOy
;qNO2=input(QNO2)
;k[qNO2-->NO2+XNOy]=CONST(M*1e-9/60*16.7)
;qNO2-->NO+XNOy
;k[qNO2-->NO+XNOy]=CONST(M*1e-9/60*0.015)

;qNO-->HONO+XNOy
;k[qNO-->HONO+XNOy]=CONST(M*1e-9/60*0.0)

;qH2O-->H2O
;qH2O=input(QH2O)
;k[qH2O-->H2O]=CONST(M*1e-2/60*9)

qH2O=input(QH2O)
qH2O-->HONO+XNOy
k[qH2O-->HONO+XNOy]=CONST(M*1e-9/60*0.002)
qH2O-->CO
k[qH2O-->CO]=CONST(M*1e-9/60*0.5)

qH2O-->NO2+XNOy
k[qH2O-->NO2+XNOy]=CONST(M*1e-9/60*0.00)
qH2O-->NO+XNOy
k[qH2O-->NO+XNOy]=CONST(M*1e-9/60*0.000)

H2O-->HONO+XNOy
k[H2O-->HONO+XNOy]=CONST(1e-012/10)

qO3-->O3
qO3=input(QO3)
k[qO3-->O3]=CONST(M*1e-9/60*52)

;qO3-->QHONO+XNOy
;k[qO3-->QHONO+XNOy]=CONST(M*1e-9/60*0.6)
;QHONO-->HONO+XNOy
;k[QHONO-->HONO+XNOy]=CONST(1/(3600*24))
;QHONO+DIL-->
;k[QHONO+DIL-->]=CONST(DILUTE)

;O3=CONST(M*50e-9)
;C5H8=CONST(M*1e-9)

SNO2 --> NO2+XNOy
;k[SNO2 --> NO2+XNOy]  = CONST(jno2/5e-3*1e-9*M/3600*HV_in*0.55)
;SNO2=CONST(1)
k[SNO2 --> NO2+XNOy]  = CONST(jno2/5e-3/3600*HV_in/1.6*0.55)
INITIAL[SNO2] = CONST(M*1e-9*3.5*0)

;SNO --> NO+XNOy
;k[SNO --> NO+XNOy]  = CONST(jno2/5e-3*1e-9*M/3600*20)
;SNO=CONST(HV_in)

;SOH --> OH
;k[SOH --> OH]  = CONST(jno2/5e-3*1e-9*M/3600)
;k[SOH --> OH]  = CONST(M*1e-9/3600*4)
;SOH=CONST(HV_in)

;SHO2 --> HO2
;k[SHO2 --> HO2]  = CONST(M*1e-9/3600*3)
;SHO2=CONST(HV_in)

;hv --> NO+XNOy
;k[hv --> NO+XNOy]  = CONST( 4.7e13 * (1. + (RH/11.6)@2) * exp(-3950./T) * jno2 )

;hv --> OH
;k[hv --> OH]  = CONST( 4.7e13 * (1. + (RH/11.6)@2) * exp(-3950./T) * jno2)

;NO2_in=input(NO2)
;NO2=CONST(NO2_in*1e-9*M)
;NO2=CONST(1e-9*M*30)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;VOC-Mix.VCP2.data 122µL 31.0s-1
qVCP2=input(qVCP2)
  qVCP2-->0.016042*LIMONENE+0.107333*PROPGLY+0.002273*APINENE+0.002273*BPINENE+0.469732*C2H5OH+0.027435*ETHGLY+0.067800*NC12H26+0.209843*IPROPOL+0.026511*TOLUENE+0.035807*MXYL+0.003172*BOX2PROL+0.008793*DIIPRETHER+0.004353*BUOX2ETOH
k[qVCP2-->0.016042*LIMONENE+0.107333*PROPGLY+0.002273*APINENE+0.002273*BPINENE+0.469732*C2H5OH+0.027435*ETHGLY+0.067800*NC12H26+0.209843*IPROPOL+0.026511*TOLUENE+0.035807*MXYL+0.003172*BOX2PROL+0.008793*DIIPRETHER+0.004353*BUOX2ETOH]=CONST(M*1e-9/60*117.813)

;VOC-Mix.gasoline.data 20µL 3.5s-1
Q_gasoline=input(qGASOLINE)
  Q_gasoline-->0.092669*CH3CHO+0.060555*BENZENE+0.242439*C2H5OH+0.146659*NC12H26+0.089599*TOLUENE+0.044085*PXYL+0.032659*OXYL+0.067681*MXYL+0.021637*TM124B+0.009209*CPENT2ENE+0.192807*IC5H12
k[Q_gasoline-->0.092669*CH3CHO+0.060555*BENZENE+0.242439*C2H5OH+0.146659*NC12H26+0.089599*TOLUENE+0.044085*PXYL+0.032659*OXYL+0.067681*MXYL+0.021637*TM124B+0.009209*CPENT2ENE+0.192807*IC5H12]=CONST(M*1e-9/60*14.5878)

;VOC-Mix.diesel.data 42µL 8.7s-1
;Q_diesel=input(qDIESEL)
;  Q_diesel-->0.047387*ACR+0.211530*C2H5CHO+0.033943*MACR+0.013388*CPENT2ENE+0.062667*DIET35TOL+0.631084*NC12H26
;k[Q_diesel-->0.047387*ACR+0.211530*C2H5CHO+0.033943*MACR+0.013388*CPENT2ENE+0.062667*DIET35TOL+0.631084*NC12H26]=CONST(M*1e-9/60*0)

;VOC-Mix.biogenic.data 37.5µL 58.7s-1
;Isopren um Faktor 3 erniedrigt
Q_biogenic=input(qBIOGENIC)
  Q_biogenic--> 0.201060*C5H8+0.205849*APINENE+0.065903*BPINENE+0.125067*LIMONENE+0.125067*X_limonene
k[Q_biogenic--> 0.201060*C5H8+0.205849*APINENE+0.065903*BPINENE+0.125067*LIMONENE+0.125067*X_limonene]=CONST(M*1e-9/60*24.2329)

;VOC-Mix.cooking.data 35.5µL 19.8s-1
Q_cooking=input(qCOOKING)
  Q_cooking-->0.268706*CH3CHO+0.338202*C2H5CHO+0.122994*C4H9CHO+0.257877*C4ALDB+0.012220*LIMONENE+0.012220*X_limonene
k[Q_cooking-->0.268706*CH3CHO+0.338202*C2H5CHO+0.122994*C4H9CHO+0.257877*C4ALDB+0.012220*LIMONENE+0.012220*X_limonene]=CONST(M*1e-9/60*31.9793)

Q_ethanol=input(Q_ethanol)
Q_ethanol-->C2H5OH
k[Q_ethanol-->C2H5OH]=CONST(M*1e-9/60*16.043) ; 11.5µL  1.29s-1

Q_ethylene=input(Q_ethylene)
Q_ethylene-->C2H4
k[Q_ethylene-->C2H4]=CONST(M*1e-9/60*7.3)

Q_propene=input(Q_propene)
Q_propene-->C3H6
k[Q_propene-->C3H6]=CONST(M*1e-9/60*3.7)

Q_13butadiene=input(Q_13butadiene)
Q_13butadiene-->C4H6
k[Q_13butadiene-->C4H6]=CONST(M*1e-9/60*0.54)

Q_isobutene=input(Q_isobutene)
Q_isobutene-->MEPROPENE
k[Q_isobutene-->MEPROPENE]=CONST(M*1e-9/60*1)

Q_isobutane=input(Q_isobutane)
Q_isobutane-->IC4H10
k[Q_isobutane-->IC4H10]=CONST(M*1e-9/60*15.4)

Q_trans2butene=input(Q_trans2butene)
Q_trans2butene-->TBUT2ENE
k[Q_trans2butene-->TBUT2ENE]=CONST(M*1e-9/60*0.22)

